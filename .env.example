# AgriDirect AI – Environment Configuration
# Copy this file to .env and fill in your values.

# ─── Server Binding ────────────────────────────────────────────────────────────
# Railway injects PORT automatically. Set HOST=0.0.0.0 to accept external traffic.
# For purely local development you can change HOST to 127.0.0.1.
HOST=0.0.0.0
PORT=8000

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite (zero-setup, local dev only – do NOT use in production):
DATABASE_URL=sqlite:///./agridirect.db

# MySQL Example:
# DATABASE_URL=mysql+pymysql://agridirect_user:your_password@localhost:3306/agridirect_db?charset=utf8mb4

# Railway PostgreSQL Example (Railway auto-sets this as $DATABASE_URL):
# DATABASE_URL=postgresql://user:password@containers-us-west-xxx.railway.app:5432/railway

# ─── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=agridirect_live_production_secret_key_2026_super_secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Map & Logistics ───────────────────────────────────────────────────────────
MAP_PROVIDER=openstreetmap
ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving

# ─── Development / Demo ────────────────────────────────────────────────────────
# Set DEMO_MODE=true to simulate live GPS movement along route points during testing.
DEMO_MODE=true
